COMPOSE_FILE=compose.oidc.yaml
STAMP_BOOK_IMAGE=ghcr.io/ironicbadger/ktz-usa-stamp-tracker:main
STAMP_BOOK_BIND=127.0.0.1
STAMP_BOOK_PORT=8770
ORIGIN=https://stamp-book.example.ts.net
OIDC_PROVIDER=tsidp
OIDC_ISSUER=https://idp.example.ts.net
OIDC_CLIENT_ID=your-registered-client-id
OIDC_CLIENT_SECRET_FILE=/absolute/path/to/oidc-client-secret
OIDC_CLIENT_AUTH_METHOD=client_secret_post
# Exact sub claim(s), not email addresses, separated by commas.
OIDC_ALLOWED_SUBJECTS=your-tailscale-user-id
